#!/usr/bin/env sh
set -eu

PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [ "$#" -ne 2 ]; then
  echo "usage: focus-or-open <yabai-app-name> <bundle-id>" >&2
  exit 2
fi

app_name="$1"
bundle_id="$2"

if command -v yabai >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  window_id="$(
    yabai -m query --windows 2>/dev/null \
      | jq -er --arg app "$app_name" '
          map(select(
            .app == $app
            and ."is-minimized" == false
            and ."is-hidden" == false
            and ."has-ax-reference" == true
          ))
          | sort_by(."is-visible", ."has-focus", .id)
          | last
          | .id
        ' 2>/dev/null || true
  )"

  if [ -n "${window_id:-}" ]; then
    yabai -m window --focus "$window_id" >/dev/null 2>&1 && exit 0
  fi
fi

exec open -b "$bundle_id"
