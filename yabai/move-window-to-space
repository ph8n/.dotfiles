#!/usr/bin/env sh
set -eu

PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

usage() {
  echo "usage: move-window-to-space <space-index>" >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

target="$1"
case "$target" in
  ''|*[!0-9]*|0)
    usage
    exit 2
    ;;
esac

if ! command -v yabai >/dev/null 2>&1; then
  exit 0
fi

# yabai has no --follow-window option. Move first, then focus the destination;
# suppress legitimate no-op errors (missing space/window or same destination).
if yabai -m window --space "$target" >/dev/null 2>&1; then
  exec yabai -m space --focus "$target" >/dev/null 2>&1
fi

exit 0
