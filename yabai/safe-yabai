#!/usr/bin/env sh
set -u

PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

if [ "$#" -lt 1 ]; then
  echo "usage: safe-yabai <yabai -m args...>" >&2
  exit 2
fi

# skhd keybindings often hit legitimate no-op states: no window in a direction,
# no next stack item, no focused window, etc. Treat those as quiet no-ops so the
# launchd stderr log stays useful.
yabai -m "$@" >/dev/null 2>&1 || true
