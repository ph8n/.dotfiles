#!/usr/bin/env sh
set -eu

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

if [ "$#" -ne 1 ]; then
  echo "usage: focus-bundle <bundle-id>" >&2
  exit 2
fi

bundle_id="$1"

# requestfront accepts a bundle id directly and prints the running app's ASN.
# Use a fresh client for every call: long-lived lsappinfo clients coalesce rapid
# focus requests and make alternating app shortcuts appear to miss keypresses.
set -- $(lsappinfo -q -nonames \
  requestfront "$bundle_id" --immediate 2>/dev/null || true)
[ "$#" -gt 0 ] && exit 0

exec open -b "$bundle_id"
