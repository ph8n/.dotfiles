#!/usr/bin/env sh
set -eu

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

if [ "$#" -ne 1 ]; then
  echo "usage: focus-bundle <bundle-id>" >&2
  exit 2
fi

bundle_id="$1"

# A bundle id is itself an app specifier. Request focus first, then use the same
# lsappinfo process to report whether the app is running. This avoids a separate
# ASN lookup and gives running apps the fast path before considering `open`.
set -- $(lsappinfo -q -nonames \
  requestfront "$bundle_id" --immediate \
  find "bundleID=$bundle_id" 2>/dev/null || true)
[ "$#" -gt 0 ] && exit 0

exec open -b "$bundle_id"
