{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Executor persists integrations in its database; use its local management API.
exec python3 - <<'PY'
import json
import os
import sys
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

command = "/etc/profiles/per-user/{{ .chezmoi.username }}/bin/browser-use-mcp"
control = Path("{{ .chezmoi.homeDir }}/.executor/server-control")
name = "Browser Use (local Helium)"
desired = {"transport": "stdio", "command": command, "args": [], "versionNegotiation": "legacy"}

def skip(reason):
    print(f"Browser Use MCP: {reason}; re-run chezmoi apply when ready", file=sys.stderr)
    sys.exit(0)

if not Path("/Applications/Executor.app").is_dir():
    sys.exit(0)
if not os.access(command, os.X_OK):
    skip("Home Manager command is not installed yet")
try:
    api = json.loads((control / "server.json").read_text())["connection"]["apiBaseUrl"]
    token = json.loads((control / "auth.json").read_text())["token"]
except FileNotFoundError:
    skip("start Executor first")

# Never send the local Executor credential to a remote server.
endpoint = urlsplit(api)
if endpoint.scheme != "http" or endpoint.hostname not in ("localhost", "127.0.0.1", "::1"):
    sys.exit("Browser Use MCP: expected a local Executor API")

def request(method, path, payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    req = Request(api + path, data=data, method=method, headers={
        "Authorization": f"Bearer {token}", "Content-Type": "application/json",
    })
    try:
        with urlopen(req, timeout=30) as response:
            return json.load(response)
    except HTTPError as error:
        sys.exit(f"Browser Use MCP: Executor returned HTTP {error.code} for {path}")
    except (URLError, TimeoutError):
        skip("Executor is unavailable")

for slug in ("browser_use_com", "browser_use"):
    path = f"/mcp/servers/{slug}"
    current = request("GET", path)
    config = current["config"] if current else {}
    cloud = config.get("transport") == "remote" and urlsplit(config.get("endpoint", "")).hostname == "api.browser-use.com"
    if cloud:
        request("DELETE", path)
        current = None
    if slug != "browser_use":
        continue
    if current:
        if all(config.get(key) == value for key, value in desired.items()):
            sys.exit(0)
        if current.get("description") != name or config.get("transport") != "stdio" or not config.get("command", "").endswith("/bin/browser-use-mcp"):
            sys.exit("Browser Use MCP: preserving unexpected existing 'browser_use' integration")
        request("POST", path + "/config", {"config": {**config, **desired}})
    else:
        try:
            with urlopen("http://127.0.0.1:9222/json/version", timeout=2):
                pass
        except (URLError, TimeoutError):
            skip("start Helium with helium-cdp first")
        request("POST", "/mcp/servers", {**desired, "name": name, "slug": slug})
PY
{{- end }}
