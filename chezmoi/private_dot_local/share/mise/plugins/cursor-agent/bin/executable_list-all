#!/usr/bin/env bash
# asdf hook: print installable versions, oldest → newest.
# Cursor does not publish a version list, so this is the installer head.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_DIR}/lib/utils.bash"

cursor_agent_latest_version
