#!/usr/bin/env bash
# asdf hook: install the package and expose only cursor-agent on PATH.
#
# mise shims every executable in $ASDF_INSTALL_PATH/bin. The CDN tarball also
# ships node, rg, and helpers, so those stay next to the wrapper and only
# cursor-agent is linked into bin/.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_DIR}/lib/utils.bash"

: "${ASDF_INSTALL_TYPE:?ASDF_INSTALL_TYPE must be set}"
: "${ASDF_INSTALL_VERSION:?ASDF_INSTALL_VERSION must be set}"
: "${ASDF_INSTALL_PATH:?ASDF_INSTALL_PATH must be set}"

[ "$ASDF_INSTALL_TYPE" = "version" ] ||
  cursor_agent_fail "only 'version' installs are supported (got type '$ASDF_INSTALL_TYPE')"

mkdir -p "$ASDF_INSTALL_PATH"

if [ -n "${ASDF_DOWNLOAD_PATH:-}" ] && [ -f "${ASDF_DOWNLOAD_PATH}/cursor-agent" ]; then
  cp -R "${ASDF_DOWNLOAD_PATH}/." "$ASDF_INSTALL_PATH/"
else
  cursor_agent_fetch "$ASDF_INSTALL_PATH" "$ASDF_INSTALL_VERSION"
fi

bin_dir="$ASDF_INSTALL_PATH/bin"
mkdir -p "$bin_dir"
ln -sfn ../cursor-agent "$bin_dir/cursor-agent"
chmod +x "$ASDF_INSTALL_PATH/cursor-agent"

"$bin_dir/cursor-agent" --version >/dev/null 2>&1 ||
  cursor_agent_fail "installed cursor-agent failed to run ($bin_dir/cursor-agent --version)"

echo "Installed cursor-agent $ASDF_INSTALL_VERSION to $bin_dir/" >&2
