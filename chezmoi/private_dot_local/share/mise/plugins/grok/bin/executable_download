#!/usr/bin/env bash
# asdf hook: download the requested version into $ASDF_DOWNLOAD_PATH.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_DIR}/lib/utils.bash"

: "${ASDF_INSTALL_VERSION:?ASDF_INSTALL_VERSION must be set}"
: "${ASDF_DOWNLOAD_PATH:?ASDF_DOWNLOAD_PATH must be set}"

grok_fetch "$ASDF_DOWNLOAD_PATH" "$ASDF_INSTALL_VERSION"
echo "Downloaded grok $ASDF_INSTALL_VERSION to $ASDF_DOWNLOAD_PATH/" >&2
