#!/usr/bin/env python3
"""Reconcile trusted skill files only. No agent runtime/config/auth directories are copied."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

STATE = ".pi-extensions-skills.json"
NAME = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")
GUARD = "Run this skill only when the user explicitly requests it. Do not start it automatically."


def digest(data):
    return hashlib.sha256(data).hexdigest()


def no_links(path):
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f"Refusing symlink path: {part}")


def tree(path):
    no_links(path)
    if not path.exists():
        return {}
    if not path.is_dir():
        raise ValueError(f"Not a directory: {path}")
    result = {}
    for item in sorted(path.rglob("*")):
        no_links(item)
        if item.is_file():
            result[item.relative_to(path).as_posix()] = item.read_bytes()
        elif not item.is_dir():
            raise ValueError(f"Not a regular supporting file: {item}")
    return result


def hashes(files):
    return {name: digest(data) for name, data in files.items()}


def load_source(source):
    """Distribute tracked files, reading working-tree edits. Never sweep a checkout."""
    no_links(source)
    skills = source / "skills"
    if not skills.is_dir():
        return None
    tracked = set(subprocess.check_output(
        ["git", "-C", str(source), "ls-files", "-z", "--", "skills"],
    ).decode().split("\0"))
    result = {}
    for directory in sorted(skills.iterdir()):
        if directory.name.startswith("."):
            raise ValueError(f"Unexpected hidden canonical entry: {directory}")
        files = tree(directory)
        if "SKILL.md" not in files:
            raise ValueError(f"Missing SKILL.md: {directory}")
        for name in files:
            relative = f"skills/{directory.name}/{name}"
            if relative not in tracked:
                raise ValueError(f"Untracked support file; review and git add before distributing: {relative}")
            parts = Path(name).parts
            if (any(p.startswith('.') or p in {'node_modules', '__pycache__', 'cache', 'caches', 'sessions', 'session-state', 'history', 'credentials', 'auth'} for p in parts)
                    or Path(name).suffix in {'.db', '.sqlite', '.sqlite3', '.pem', '.key', '.pyc'}
                    or Path(name).name in {'auth.json', 'auth.toml', 'credentials.json', 'secrets.json', 'secrets.toml', 'mcp.json', 'mcp.jsonc', 'history.jsonl', 'session_index.jsonl'}
                    or (name != 'SKILL.md' and Path(name).name == 'SKILL.md')):
                raise ValueError(f"Forbidden runtime/secret/nested-skill path: {relative}")
        text = files['SKILL.md'].decode()
        match = re.match(r"\A---\n(.*?)\n---\n", text, re.S)
        if not match:
            raise ValueError(f"Invalid frontmatter: {directory}")
        names = re.findall(r"^name: ([^\n]+)$", match[1], re.M)
        descriptions = re.findall(r"^description: (.+)$", match[1], re.M)
        if len(names) != 1 or not NAME.fullmatch(names[0]) or len(names[0]) > 64 or not descriptions:
            raise ValueError(f"Invalid name/description: {directory}")
        name = names[0]
        if name in result:
            raise ValueError(f"Duplicate canonical name: {name}")
        result[name] = files
        if name != directory.name:
            raise ValueError(f"Name must match directory: {directory}")
    if not result:
        raise ValueError("Empty canonical skill inventory; refusing mass deletion")
    for name in ('THIRD_PARTY_NOTICES.md', 'LICENSE'):
        no_links(source / name)
        data = (source / name).read_bytes()
        for files in result.values():
            if name in files:
                raise ValueError(f"Reserved distribution filename: {name}")
            files[name] = data
    return result


def render(files, adapter):
    if adapter not in {'standard', 'codex', 'explicit-guard'}:
        raise ValueError(f"Unknown adapter: {adapter}")
    # Pi owns its source wording. Other agents invoke skills by semantic name,
    # not Pi's /skill: command syntax; adapt Markdown and shell support copies.
    result = {}
    for filename, data in files.items():
        if filename not in {'LICENSE', 'THIRD_PARTY_NOTICES.md'} and Path(filename).suffix in {'.md', '.sh'}:
            data = re.sub(rb'/skill:([a-z0-9]+(?:-[a-z0-9]+)*)', rb'\1', data)
            if b'/skill:' in data:
                raise ValueError(f"Nonportable invocation syntax: {filename}")
        result[filename] = data
    text = result['SKILL.md'].decode()
    header, body = text.split('\n---\n', 1)
    manual = '\ndisable-model-invocation: true' in header
    if manual and adapter == 'codex':
        if 'agents/openai.yaml' in result:
            raise ValueError("Refusing to overwrite canonical agents/openai.yaml")
        result['agents/openai.yaml'] = b'policy:\n  allow_implicit_invocation: false\n'
    if manual and adapter == 'explicit-guard':
        # OpenCode ignores disable-model-invocation. This is an instruction guard,
        # not an enforced permission boundary. Keep the full substantive body.
        header = re.sub(r'(?m)^description: (.+)$',
                        lambda m: 'description: ' + json.dumps('Only when explicitly requested by the user. ' + m[1].strip('"')), header)
        body = '\n' + GUARD + '\n' + body
    result['SKILL.md'] = (header + '\n---\n' + body).encode()
    return result


def write_atomic(path, data):
    no_links(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix='.skill-sync-', delete=False) as temp:
        pending = Path(temp.name)
        temp.write(data)
    try:
        os.chmod(pending, 0o644)
        pending.replace(path)
    finally:
        pending.unlink(missing_ok=True)


def save_state(root, state):
    data = (json.dumps(state, sort_keys=True, indent=2) + '\n').encode()
    path = root / STATE
    if not path.exists() or path.read_bytes() != data:
        write_atomic(path, data)


def plan(root, desired, legacy):
    no_links(root)
    state_path = root / STATE
    no_links(state_path)
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    if not isinstance(state, dict) or any(not NAME.fullmatch(n) for n in state):
        raise ValueError(f"Invalid ownership manifest: {state_path}")
    if any(not NAME.fullmatch(name) for name in legacy):
        raise ValueError("Invalid legacy skill name")
    names = set(state) | set(desired)
    # Legacy hash allowlist is the sole authority for adopting pre-manifest copies,
    # including removed/renamed skills. Never infer ownership from a name alone.
    names |= {name for name in legacy if (root / name).exists()}
    operations = []
    for name in sorted(names):
        current = tree(root / name)
        actual = hashes(current)
        wanted = desired.get(name, {})
        expected = hashes(wanted)
        owned = state.get(name)
        if current and owned is None and actual != legacy.get(name):
            if name in desired:
                raise ValueError(f"Unowned skill collision (preserved): {root / name}")
            continue
        if current and owned is not None and actual != owned:
            raise ValueError(f"Modified managed skill (preserved); move it aside or restore it: {root / name}")
        if current != wanted or (wanted and owned != expected) or (not wanted and owned is not None):
            operations.append((name, current, wanted))
    return root, state, operations


def apply_plan(root, state, operations):
    for name, current, wanted in operations:
        folder = root / name
        # Preflight again under the process lock. No recursive destination removal.
        if tree(folder) != current:
            raise ValueError(f"Destination changed during sync: {folder}")
        for file, data in wanted.items():
            if current.get(file) != data:
                write_atomic(folder / file, data)
        for file in current.keys() - wanted.keys():
            (folder / file).unlink()
        if folder.exists():
            for directory in sorted((p for p in folder.rglob('*') if p.is_dir()), key=lambda p: len(p.parts), reverse=True):
                if not any(directory.iterdir()):
                    directory.rmdir()
            if not any(folder.iterdir()):
                folder.rmdir()
        if wanted:
            state[name] = hashes(wanted)
        else:
            state.pop(name, None)
        save_state(root, state)


def sync(home, source, config, legacy, dry_run=False):
    canonical = load_source(source)
    if canonical is None:
        print(f"sync-agent-skills: source missing: {source}/skills; clone pi-extensions there and rerun chezmoi apply. Existing skills untouched.", file=sys.stderr)
        return
    roots = {}
    for target, entry in config['targets'].items():
        if set(entry) != {'path', 'adapter'}:
            raise ValueError(f"Each agent requires its own path and adapter: {target}")
        if entry['path'] in roots:
            raise ValueError(f"Duplicate target path: {entry['path']}")
        roots[entry['path']] = {name: render(files, entry['adapter']) for name, files in canonical.items()}
    for path in config.get('legacy_cleanup', []):
        roots[path] = {}
    plans = []
    for relative, desired in roots.items():
        if Path(relative).is_absolute() or '..' in Path(relative).parts:
            raise ValueError(f"Target must be home-relative: {relative}")
        root = home / relative
        no_links(root)
        destination = root.resolve()
        source_root = source.resolve()
        if (destination == source_root or source_root in destination.parents
                or destination in source_root.parents):
            raise ValueError(f"Destination overlaps read-only source checkout: {root}")
        plans.append(plan(root, desired, legacy))
    # Validate EVERY destination before changing ANY destination.
    for root, state, operations in plans:
        if operations:
            print(f"{'Would reconcile' if dry_run else 'Reconcile'} {root}: {', '.join(n for n, _, _ in operations)}")
            if not dry_run:
                apply_plan(root, state, operations)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=Path.home())
    parser.add_argument('--source', type=Path)
    parser.add_argument('--config', type=Path)
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    config_path = args.config or args.home / '.config/agent-skills/targets.json'
    config = json.loads(config_path.read_text())
    legacy = json.loads(config_path.with_name('legacy.json').read_text())
    source = args.source or args.home / config['source']
    # A lock outside discovery roots serializes apply and the explicit command.
    lock = args.home / '.local/state/agent-skills/sync.lock'
    no_links(lock)
    lock.parent.mkdir(parents=True, exist_ok=True)
    with lock.open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        sync(args.home, source, config, legacy, args.dry_run)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f'sync-agent-skills: {error}')
