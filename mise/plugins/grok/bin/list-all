#!/usr/bin/env bash
# asdf hook: print installable versions, oldest → newest.
# xAI only publishes the current stable version at https://x.ai/cli/stable.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "${PLUGIN_DIR}/lib/utils.bash"

grok_latest_version
