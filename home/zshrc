typeset -U path PATH fpath

# Add user tools without discarding platform paths such as NixOS setuid
# wrappers. Inside a Nix development shell, preserve the flake's PATH.
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  path=(
    "$HOME/.cargo/bin"
    "$HOME/.grok/bin"
    "$HOME/.local/bin"
    $path
  )
  if [[ "$OSTYPE" == darwin* ]]; then
    path+=(
      "/opt/homebrew/bin"
      "/opt/homebrew/sbin"
      "$HOME/.lmstudio/bin"
    )
  fi

  (( $+commands[mise] )) && eval "$(mise activate zsh)"
  fpath=("$HOME/.grok/completions/zsh" $fpath)
fi

# Integrations
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

if (( $+commands[fzf] )); then
  (( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always {}'"
  source <(fzf --zsh)
  bindkey -r '^[c'
fi

# Editor, aliases, and keybindings
export EDITOR="nvim"
export VISUAL="$EDITOR"

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^G' edit-command-line

ulimit -n 65536
