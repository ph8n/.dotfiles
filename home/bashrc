# Add user tools without discarding platform paths such as NixOS setuid
# wrappers. Inside a Nix development shell, preserve the flake's PATH.
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  PATH="$HOME/.local/share/mise/shims:$HOME/.cargo/bin:$HOME/.grok/bin:$HOME/.local/bin:$PATH"
  if [[ "$OSTYPE" == darwin* ]]; then
    PATH="$PATH:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.lmstudio/bin"
  fi
  export PATH

  # Shims select the configured tool version per invocation without running
  # mise's comparatively expensive shell hook at every startup.
  [[ -r "$HOME/.grok/completions/bash/grok.bash" ]] && source "$HOME/.grok/completions/bash/grok.bash"
fi

# Editor
export EDITOR="nvim"
export VISUAL="$EDITOR"

ulimit -n 65536

# Nix runs a development shell's shellHook after Bash reads .bashrc, so update
# the flake indicator immediately before Starship draws each prompt. Finding
# the originating root happens only once; changing directories uses builtins.
_nix_update_flake_prompt() {
  if [[ -z "${IN_NIX_SHELL:-}" ]]; then
    unset NIX_FLAKE_INSIDE NIX_FLAKE_OUTSIDE
    return 0
  fi

  if [[ -z "${_NIX_FLAKE_ROOT_CAPTURED:-}" ]]; then
    local root="$PWD"
    while [[ "$root" != "/" && ! -f "$root/flake.nix" ]]; do
      root="${root%/*}"
      [[ -n "$root" ]] || root="/"
    done

    if [[ -f "$root/flake.nix" ]]; then
      export NIX_FLAKE_ROOT="$root"
    else
      unset NIX_FLAKE_ROOT
    fi
    _NIX_FLAKE_ROOT_CAPTURED=1
  fi

  if [[ -n "${NIX_FLAKE_ROOT:-}" && "$PWD/" == "$NIX_FLAKE_ROOT/"* ]]; then
    export NIX_FLAKE_INSIDE=1
    unset NIX_FLAKE_OUTSIDE
  else
    unset NIX_FLAKE_INSIDE
    export NIX_FLAKE_OUTSIDE=1
  fi
}
starship_precmd_user_func=_nix_update_flake_prompt
