#!/usr/bin/env sh
set -eu

if [ "$#" -ne 0 ]; then
  echo "usage: focus-previous-app" >&2
  exit 2
fi

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# LaunchServices reports visible apps in front-to-back order. The second ASN is
# the previous app. This keeps alt-q to two fast lsappinfo calls instead of
# querying bundle ids for every visible process.
set -- $(lsappinfo -nonames visibleProcessList 2>/dev/null || true)
[ "$#" -ge 2 ] || exit 1

exec lsappinfo requestfront "$2" --immediate >/dev/null 2>&1
