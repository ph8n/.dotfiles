# AeroSpace-like yabai bindings.
# App bindings focus/open the requested app only; no same-app window cycling.
# Keep high-frequency yabai hotkeys direct and quiet. skhd already runs each
# command through a shell; extra wrapper scripts and query+jq paths add latency.
# In stack layout, use alt-tab/shift-alt-tab to move within the stack; h/j/k/l
# directional focus is mainly useful after switching the space to bsp.

# Layout. Stack gives one full-screen managed window at a time; BSP gives splits.
alt - 0x2C : "$HOME/.nix-profile/bin/yabai" -m space --layout bsp >/dev/null 2>&1
alt - 0x2B : "$HOME/.nix-profile/bin/yabai" -m space --layout stack >/dev/null 2>&1

# Focus.
alt - tab         : "$HOME/.nix-profile/bin/yabai" -m window --focus stack.next >/dev/null 2>&1
alt + shift - tab : "$HOME/.nix-profile/bin/yabai" -m window --focus stack.prev >/dev/null 2>&1
alt - h : "$HOME/.nix-profile/bin/yabai" -m window --focus west >/dev/null 2>&1
alt - j : "$HOME/.nix-profile/bin/yabai" -m window --focus south >/dev/null 2>&1
alt - k : "$HOME/.nix-profile/bin/yabai" -m window --focus north >/dev/null 2>&1
alt - l : "$HOME/.nix-profile/bin/yabai" -m window --focus east >/dev/null 2>&1

# Spaces (yabai index on current display; 1-based). Missing/already-focused
# spaces are quiet no-ops.
alt - 1 : "$HOME/.nix-profile/bin/yabai" -m space --focus 1 >/dev/null 2>&1
alt - 2 : "$HOME/.nix-profile/bin/yabai" -m space --focus 2 >/dev/null 2>&1
alt - 3 : "$HOME/.nix-profile/bin/yabai" -m space --focus 3 >/dev/null 2>&1
alt - 4 : "$HOME/.nix-profile/bin/yabai" -m space --focus 4 >/dev/null 2>&1
alt - 5 : "$HOME/.nix-profile/bin/yabai" -m space --focus 5 >/dev/null 2>&1
alt - 6 : "$HOME/.nix-profile/bin/yabai" -m space --focus 6 >/dev/null 2>&1
alt - 7 : "$HOME/.nix-profile/bin/yabai" -m space --focus 7 >/dev/null 2>&1
alt - 8 : "$HOME/.nix-profile/bin/yabai" -m space --focus 8 >/dev/null 2>&1
alt - 9 : "$HOME/.nix-profile/bin/yabai" -m space --focus 9 >/dev/null 2>&1
alt - 0 : "$HOME/.nix-profile/bin/yabai" -m space --focus 10 >/dev/null 2>&1
alt + shift - 1 : "$HOME/.nix-profile/bin/yabai" -m window --space 1 --follow-window >/dev/null 2>&1
alt + shift - 2 : "$HOME/.nix-profile/bin/yabai" -m window --space 2 --follow-window >/dev/null 2>&1
alt + shift - 3 : "$HOME/.nix-profile/bin/yabai" -m window --space 3 --follow-window >/dev/null 2>&1
alt + shift - 4 : "$HOME/.nix-profile/bin/yabai" -m window --space 4 --follow-window >/dev/null 2>&1
alt + shift - 5 : "$HOME/.nix-profile/bin/yabai" -m window --space 5 --follow-window >/dev/null 2>&1
alt + shift - 6 : "$HOME/.nix-profile/bin/yabai" -m window --space 6 --follow-window >/dev/null 2>&1
alt + shift - 7 : "$HOME/.nix-profile/bin/yabai" -m window --space 7 --follow-window >/dev/null 2>&1
alt + shift - 8 : "$HOME/.nix-profile/bin/yabai" -m window --space 8 --follow-window >/dev/null 2>&1
alt + shift - 9 : "$HOME/.nix-profile/bin/yabai" -m window --space 9 --follow-window >/dev/null 2>&1
alt + shift - 0 : "$HOME/.nix-profile/bin/yabai" -m window --space 10 --follow-window >/dev/null 2>&1

# Move/reorder.
alt + shift - h : "$HOME/.nix-profile/bin/yabai" -m window --swap west >/dev/null 2>&1
alt + shift - j : "$HOME/.nix-profile/bin/yabai" -m window --swap south >/dev/null 2>&1
alt + shift - k : "$HOME/.nix-profile/bin/yabai" -m window --swap north >/dev/null 2>&1
alt + shift - l : "$HOME/.nix-profile/bin/yabai" -m window --swap east >/dev/null 2>&1

# Resize.
alt + shift - 0x1B : "$HOME/.nix-profile/bin/yabai" -m window --ratio rel:-0.05 >/dev/null 2>&1
alt + shift - 0x18 : "$HOME/.nix-profile/bin/yabai" -m window --ratio rel:0.05 >/dev/null 2>&1

# Opt the focused window into/out of tiling.
alt + shift - space : "$HOME/.nix-profile/bin/yabai" -m window --toggle float >/dev/null 2>&1

# App-first jumps. Bundle ids avoid apps.tsv lookup on every keypress.
alt - 0x29      : ~/.config/yabai/focus-bundle com.mitchellh.ghostty
alt - a         : ~/.config/yabai/focus-bundle com.openai.chat
alt - c         : ~/.config/yabai/focus-bundle com.openai.codex
alt - f         : ~/.config/yabai/focus-bundle net.imput.helium
alt - d         : ~/.config/yabai/focus-bundle com.hnc.Discord
alt - s         : ~/.config/yabai/focus-bundle com.tinyspeck.slackmacgap
alt - n         : ~/.config/yabai/focus-bundle notion.id
alt - b         : ~/.config/yabai/focus-bundle info.sioyek.sioyek
alt - p         : ~/.config/yabai/focus-bundle com.spotify.client
alt - m         : ~/.config/yabai/focus-bundle com.apple.MobileSMS
alt - e         : ~/.config/yabai/focus-bundle com.apple.finder
alt - i         : ~/.config/yabai/focus-bundle com.apple.mail

# Fast previous-app toggle.
alt - q : set -- $(/usr/bin/lsappinfo -nonames visibleProcessList 2>/dev/null); [ $# -ge 2 ] && /usr/bin/lsappinfo requestfront "$2" --immediate >/dev/null 2>&1

# AeroSpace service-mode equivalents as direct bindings.
alt + shift - 0x29      : "$HOME/.nix-profile/bin/yabai" -m space --balance >/dev/null 2>&1
alt + shift - f         : "$HOME/.nix-profile/bin/yabai" -m window --toggle zoom-fullscreen >/dev/null 2>&1
alt + shift - backspace : "$HOME/.nix-profile/bin/yabai" -m window --close >/dev/null 2>&1
