# AeroSpace-like yabai bindings.
# App bindings focus/open the requested app only; no same-app window cycling.

# Layout. Stack gives one full-screen managed window at a time; BSP gives splits.
alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

# Focus.
alt - tab         : yabai -m window --focus stack.next
alt + shift - tab : yabai -m window --focus stack.prev
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Spaces (yabai index on current display; 1-based).
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10
alt + shift - 1 : yabai -m window --space 1 --follow-window
alt + shift - 2 : yabai -m window --space 2 --follow-window
alt + shift - 3 : yabai -m window --space 3 --follow-window
alt + shift - 4 : yabai -m window --space 4 --follow-window
alt + shift - 5 : yabai -m window --space 5 --follow-window
alt + shift - 6 : yabai -m window --space 6 --follow-window
alt + shift - 7 : yabai -m window --space 7 --follow-window
alt + shift - 8 : yabai -m window --space 8 --follow-window
alt + shift - 9 : yabai -m window --space 9 --follow-window
alt + shift - 0 : yabai -m window --space 10 --follow-window

# Move/reorder.
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# Resize.
alt + shift - 0x1B : yabai -m window --ratio rel:-0.05
alt + shift - 0x18 : yabai -m window --ratio rel:0.05

# Opt the focused window into/out of tiling.
alt + shift - space : yabai -m window --toggle float

# App-first jumps. App names and bundle ids live in ~/.config/yabai/apps.tsv.
alt - 0x29      : ~/.config/yabai/focus-or-open ghostty
alt - a         : ~/.config/yabai/focus-or-open chatgpt
alt - c         : ~/.config/yabai/focus-or-open codex
alt - f         : ~/.config/yabai/focus-or-open helium
alt - d         : ~/.config/yabai/focus-or-open discord
alt - s         : ~/.config/yabai/focus-or-open slack
alt - o         : ~/.config/yabai/focus-or-open logseq
alt - n         : ~/.config/yabai/focus-or-open notion
alt - b         : ~/.config/yabai/focus-or-open sioyek
alt - p         : ~/.config/yabai/focus-or-open spotify
alt - m         : ~/.config/yabai/focus-or-open messages
alt - e         : ~/.config/yabai/focus-or-open finder
alt - i         : ~/.config/yabai/focus-or-open mail

# Fast previous-app toggle.
alt - q : ~/.config/skhd/focus-previous-app

# AeroSpace service-mode equivalents as direct bindings.
alt + shift - 0x29      : yabai -m space --balance
alt + shift - f         : yabai -m window --toggle zoom-fullscreen
alt + shift - backspace : yabai -m window --close
