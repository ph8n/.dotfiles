#!/bin/sh
# LaunchAgent wrapper for skhd.
# Retries startup failures such as Secure Keyboard Entry being held briefly by
# loginwindow at login, and restarts skhd if it crashes.

USER_PROFILE="/etc/profiles/per-user/${USER:-${HOME##*/}}"
PATH="$USER_PROFILE/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# skhd executes bindings through "$SHELL -c". Pin this to bash so hotkey
# latency cannot regress if launchd inherits zsh/fish or a future shell startup
# file gets expensive.
SHELL="/bin/bash"
export SHELL

SKHD_BIN="${SKHD_BIN:-$USER_PROFILE/bin/skhd}"
SKHD_CONFIG="$HOME/.config/skhd/skhdrc"
FOCUS_FIFO="$HOME/.cache/skhd/app-focus.fifo"
RETRY_DELAY="${RETRY_DELAY:-5}"
STARTUP_DELAY="${STARTUP_DELAY:-8}"
child=""
focus_broker=""

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2
}

stop_child() {
  if [ -n "${child:-}" ]; then
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
}

# Keep one LaunchServices client initialized and feed it focus requests through
# fd 9. Every shell spawned by skhd inherits this descriptor, making app focus
# a shell-builtin FIFO write instead of a new lsappinfo process.
start_focus_broker() {
  rm -f "$FOCUS_FIFO"
  /usr/bin/mkfifo "$FOCUS_FIFO" || return 1
  /usr/bin/lsappinfo file "$FOCUS_FIFO" forever >/dev/null 2>&1 &
  focus_broker=$!

  # The broker and this writer open unblock each other. Keep the writer open so
  # lsappinfo continues reading commands across skhd restarts.
  exec 9>"$FOCUS_FIFO"
}

stop_focus_broker() {
  exec 9>&-
  if [ -n "${focus_broker:-}" ]; then
    kill "$focus_broker" 2>/dev/null || true
    wait "$focus_broker" 2>/dev/null || true
  fi
  rm -f "$FOCUS_FIFO"
}

terminate() {
  stop_child
  stop_focus_broker
  exit 0
}

trap terminate INT TERM

if [ "${STARTUP_DELAY}" -gt 0 ] 2>/dev/null; then
  sleep "${STARTUP_DELAY}" &
  child=$!
  wait "$child" || exit 0
  child=""
fi

if ! start_focus_broker; then
  log "failed to start app-focus broker"
  exit 1
fi

while :; do
  log "starting skhd"
  "$SKHD_BIN" -c "$SKHD_CONFIG" &
  child=$!
  wait "$child"
  status=$?
  child=""

  # Some macOS startup failures (notably Accessibility/Input Monitoring not
  # being ready yet) can make daemons exit with status 0. A clean exit is not
  # useful here: skhd is expected to remain alive, while intentional shutdown
  # is handled by the TERM/INT trap above. Retry every unexpected exit.
  if [ "$status" -eq 0 ]; then
    log "skhd exited; restarting in ${RETRY_DELAY}s"
  else
    log "skhd exited with status $status; restarting in ${RETRY_DELAY}s"
  fi

  sleep "${RETRY_DELAY}" &
  child=$!
  wait "$child" || exit 0
  child=""
done
